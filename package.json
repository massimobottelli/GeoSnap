{
  "name": "geosnap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GeoSnap — gioco didattico mobile-first: trascina le sagome delle nazioni sulla mappa dell'Europa.",
  "license": "SEE LICENSE IN doc",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:map": "node scripts/generate-map.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "setup:macos": "bash scripts/setup-macos.sh",
    "setup:linux": "bash scripts/setup-linux.sh"
  },
  "dependencies": {
    "d3-zoom": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "canvas": "^3.2.3",
    "d3-geo": "^3.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
